{
  "name": "nutricional",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  // O Cloudflare cria o armazenamento sozinho na primeira publicação
  "kv_namespaces": [{ "binding": "NUTRI" }]
}
